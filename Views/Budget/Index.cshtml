@model List<Databas.Models.ExpenseModel>

@{
    ViewData["Title"] = "Budgetöversikt";
}

@{
    string currentSort = ViewBag.CurrentSort as string;
    int? currentCategory = ViewBag.CurrentCategoryFilter as int?;
    bool hideSummary = ViewBag.HideSummary == true;
}

@if (!hideSummary)
{
    <h3>@ViewBag.BudgetName</h3>
    <p>
        <strong>Limit:</strong> @ViewBag.BudgetLimit kr<br />
        <strong>Total spent:</strong> @ViewBag.TotalAmount kr<br />
        <strong>Remaining:</strong> @ViewBag.Remaining kr
    </p>
}

<form method="get" asp-action="Index" class="mb-3">
    <input type="hidden" name="sortOrder" value="@currentSort" />
    <input type="hidden" name="categoryFilter" value="@(currentCategory.HasValue ? currentCategory.ToString() : "")" />
    <div class="form-check">
        <input type="checkbox"
               class="form-check-input"
               id="hideSummary"
               name="hideSummary"
               value="true"
               @(hideSummary ? "checked=\"checked\"" : "")
               onchange="this.form.submit()" />
        <label class="form-check-label" for="hideSummary">
            Hide info
        </label>
    </div>
</form>

<hr />

<p>
    <a asp-action="Add"
       class="btn btn-primary btn-sm"
       style="width: 170px; display:inline-block; margin-right:8px;">
        Add new expense
    </a>

    <a asp-action="Manage"
       class="btn btn-secondary btn-sm"
       style="width: 170px; display:inline-block;">
        Manage budget
    </a>
</p>

<form method="get" asp-action="Index" class="mb-3">
    <select id="sortOrder"
            name="sortOrder"
            class="form-control form-control-sm"
            style="width: 170px; display:inline-block; margin-right: 8px; text-align-last:center; text-align:center;"
            onchange="this.form.submit()">
        <option value="">No sorting</option>

        @if (currentSort == "cheapest")
        {
            <option value="cheapest" selected>Price Low-High</option>
        }
        else
        {
            <option value="cheapest">Price Low-High</option>
        }

        @if (currentSort == "expensive")
        {
            <option value="expensive" selected>Price High-Low</option>
        }
        else
        {
            <option value="expensive">Price High-Low</option>
        }

        @if (currentSort == "newest")
        {
            <option value="newest" selected>Newest</option>
        }
        else
        {
            <option value="newest">Newest</option>
        }

        @if (currentSort == "oldest")
        {
            <option value="oldest" selected>Oldest</option>
        }
        else
        {
            <option value="oldest">Oldest</option>
        }
    </select>

    <select id="categoryFilter"
            name="categoryFilter"
            class="form-control form-control-sm"
            style="width: 170px; display:inline-block; text-align-last:center; text-align:center;"
            onchange="this.form.submit()">
        <option value="">All Categories</option>

        @if (currentCategory == 1)
        {
            <option value="1" selected>Home</option>
        }
        else
        {
            <option value="1">Home</option>
        }

        @if (currentCategory == 2)
        {
            <option value="2" selected>Food</option>
        }
        else
        {
            <option value="2">Food</option>
        }

        @if (currentCategory == 3)
        {
            <option value="3" selected>Pleasure</option>
        }
        else
        {
            <option value="3">Pleasure</option>
        }
    </select>
</form>

@if (ViewBag.LastAmount != null)
{
    <p>
        Senaste tillagd: @ViewBag.LastDescription - @ViewBag.LastAmount kr<br />
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Amount</th>
            <th>Description</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Amount</td>
            <td>@item.Description</td>
        </tr>
    }
    </tbody>
</table>
