@model List<Databas.Models.ExpenseModel>

@{
    ViewData["Title"] = "Budgetöversikt";
}

<h1>Budgetöversikt</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>UserId</th>
            <th>BudgetId</th>
            <th>CategoryId</th>
            <th>Amount</th>
            <th>Description</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.UserId</td>
            <td>@item.BudgetId</td>
            <td>@item.CategoryId</td>
            <td>@item.Amount</td>
            <td>@item.Description</td>
        </tr>
    }
    </tbody>
</table>
